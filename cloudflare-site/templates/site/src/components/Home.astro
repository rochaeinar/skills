---
// Starting point of the landing page. Rebuild it to match the mockup approved in Claude Design:
// sections, order, palette and type are per app; keep the data in src/i18n and the images in src/assets.
import { Picture } from "astro:assets";
import * as icons from "@lucide/astro";
import PlayBadge from "@sites/ui/PlayBadge.astro";
import YouTube from "@sites/ui/YouTube.astro";
import Layout from "./Layout.astro";
import { t, site } from "../i18n";

interface Props { lang: string }
const { lang } = Astro.props;
const tx = t(lang);
// Screenshots: src/assets/screens/<lang>/*.png (or src/assets/screens/*.png for every language), in name order.
const all = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/**/*.{png,jpg,webp}", { eager: true });
const pick = (prefix: string) => Object.entries(all).filter(([p]) => p.startsWith(prefix)).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const screens = [pick(`../assets/screens/${lang}/`), pick("../assets/screens/")].find((s) => s.length) ?? [];
const video = (site.youtube as Record<string, string>)[lang];
const Icon = (name: string) => (icons as Record<string, any>)[name] ?? icons.Sparkles;
---
<Layout lang={lang} path="/">
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{tx.hero.eyebrow}</p>
        <h1>{tx.hero.title}</h1>
        <p class="lead muted">{tx.hero.subtitle}</p>
        <div class="actions">
          {site.play.package && <PlayBadge pkg={site.play.package} lang={lang} />}
          <span class="muted note">{tx.hero.note}</span>
        </div>
      </div>
      {screens[0] && (
        <div class="phone">
          <Picture src={screens[0]} alt={tx.hero.title} formats={["avif", "webp"]} widths={[360, 720]} sizes="(max-width: 800px) 70vw, 360px" loading="eager" fetchpriority="high" />
        </div>
      )}
    </div>
  </section>

  <section id="features" class="container section">
    <h2>{tx.features.title}</h2>
    <p class="muted sub">{tx.features.subtitle}</p>
    <div class="grid">
      {tx.features.items.map((f) => {
        const I = Icon(f.icon);
        return (
          <article class="card">
            <span class="icon"><I size={22} aria-hidden="true" /></span>
            <h3>{f.title}</h3>
            <p class="muted">{f.text}</p>
          </article>
        );
      })}
    </div>
  </section>

  {screens.length > 1 && (
    <section id="screens" class="section">
      <div class="container"><h2>{tx.screens.title}</h2><p class="muted sub">{tx.screens.subtitle}</p></div>
      <div class="shots" tabindex="0">
        {screens.map((s, i) => (
          <Picture src={s} alt={`${site.name} ${i + 1}`} formats={["avif", "webp"]} widths={[280, 560]} sizes="280px" loading="lazy" />
        ))}
      </div>
    </section>
  )}

  {video && (
    <section id="video" class="container section">
      <h2>{tx.video.title}</h2>
      <div class="video"><YouTube id={video} title={tx.video.title} /></div>
    </section>
  )}

  <section id="faq" class="container section narrow">
    <h2>{tx.faq.title}</h2>
    {tx.faq.items.map((f) => (<details><summary>{f.q}</summary><p class="muted">{f.a}</p></details>))}
  </section>

  <section class="container section cta">
    <h2>{tx.cta.title}</h2>
    <p class="muted">{tx.cta.text}</p>
    {site.play.package && <PlayBadge pkg={site.play.package} lang={lang} utm="website-cta" />}
  </section>
</Layout>

<style>
  .hero { padding: clamp(48px, 9vw, 120px) 0 48px; background:
          radial-gradient(60% 60% at 80% 20%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 48px; align-items: center; }
  .eyebrow { color: var(--accent); font-weight: 600; letter-spacing: .08em; text-transform: uppercase; font-size: .85rem; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.4rem); }
  .lead { font-size: clamp(1.1rem, 2vw, 1.3rem); max-width: 34ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 28px; }
  .note { font-size: .95rem; }
  .phone { justify-self: center; width: min(360px, 70vw); border-radius: 44px; padding: 10px; background: #0b0d10;
           box-shadow: var(--shadow), inset 0 0 0 2px #2a2f36; }
  .phone :global(img) { border-radius: 34px; width: 100%; }
  .section { padding-top: clamp(64px, 9vw, 112px); }
  .section h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); }
  .sub { max-width: 60ch; margin-bottom: 36px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; }
  .card h3 { font-size: 1.15rem; margin-top: 16px; }
  .icon { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px;
          background: color-mix(in srgb, var(--accent) 14%, transparent); color: var(--accent); }
  .shots { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 8px max(16px, calc((100vw - var(--max)) / 2)) 24px; }
  .shots :global(img) { flex: 0 0 auto; width: 260px; border-radius: 28px; scroll-snap-align: center; box-shadow: var(--shadow); }
  .video { border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  .narrow { max-width: 760px; }
  details { border-bottom: 1px solid var(--border); padding: 18px 0; }
  summary { cursor: pointer; font-weight: 600; font-size: 1.05rem; }
  .cta { text-align: center; }
  .cta p { margin-inline: auto; max-width: 50ch; }
  @media (max-width: 800px) { .hero-grid { grid-template-columns: 1fr; } }
</style>
