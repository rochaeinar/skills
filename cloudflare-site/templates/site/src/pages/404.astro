---
import Layout from "../components/Layout.astro";
import { t, defaultLocale, localePath } from "../i18n";
const tx = t(defaultLocale);
---
<Layout lang={defaultLocale} path="/404/" title={tx.notFound.title} description={tx.notFound.text}>
  <section class="wrap" style="padding: 120px 0; text-align: center">
    <h1 class="display" style="font-size: clamp(2.4rem, 6vw, 4rem)">{tx.notFound.title}</h1>
    <p style="color: var(--muted)">{tx.notFound.text}</p>
    <a href={localePath(defaultLocale)}>{tx.notFound.home}</a>
  </section>
</Layout>
