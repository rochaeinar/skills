---
// Light/dark: follows the system (prefers-color-scheme) until the visitor picks one with this button;
// the choice is kept in localStorage ("theme": "light" | "dark") and set on <html data-theme>.
// Put <ThemeScript /> in <head> (before the CSS paints) and <ThemeToggle /> where the button goes.
interface Props { labels: { light: string; dark: string }; class?: string }
const { labels, class: cls } = Astro.props;
---
<button type="button" class:list={["theme-toggle", cls]} data-label-light={labels.light} data-label-dark={labels.dark} aria-label={labels.dark}>
  <svg class="sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
  <svg class="moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path></svg>
</button>
<script>
  const root = document.documentElement;
  const isDark = () => root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  for (const b of document.querySelectorAll<HTMLButtonElement>(".theme-toggle")) {
    const label = () => b.setAttribute("aria-label", isDark() ? b.dataset.labelLight! : b.dataset.labelDark!);
    label();
    b.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try { localStorage.setItem("theme", next); } catch {}
      label();
    });
  }
</script>
<style>
  .theme-toggle { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
                  border: 0; background: transparent; color: inherit; cursor: pointer; }
  .theme-toggle:hover { background: color-mix(in srgb, currentColor 10%, transparent); }
  .theme-toggle .moon { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .sun { display: none; }
  :global(:root[data-theme="dark"]) .theme-toggle .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle .sun { display: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle .moon { display: block; }
  }
</style>
