<?xml version="1.0" encoding="utf-8"?>
<!-- About and its documents (English, the default). Every language of the app gets these labels
     translated (values-xx/about_strings.xml or the app's strings.xml). The documents themselves
     (assets/legal/*.md) are in English only and are never translated. -->
<resources>
    <string name="about_title">About</string>
    <!-- %1$s versionName, %2$d versionCode -->
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_section_documents">Legal &amp; information</string>
    <string name="about_privacy">Privacy policy</string>
    <string name="about_terms">Terms and conditions</string>
    <string name="about_licenses">Third-party licenses</string>
    <string name="about_open_website">Open the website</string>
    <string name="about_back">Back</string>
    <string name="about_developed_by">Developed by <b>{{DEVELOPER}}</b></string>
    <string name="about_copyright" translatable="false">© {{YEAR}} {{DEVELOPER}}</string>
    <!-- The official website: written by cloudflare-site, checked by `web.py legal` -->
    <string name="about_web_label" translatable="false">{{DOMAIN}}</string>
    <string name="about_web_url" translatable="false">https://{{DOMAIN}}</string>
    <string name="privacy_policy_url" translatable="false">https://{{DOMAIN}}/privacy/</string>
</resources>
