<?xml version="1.0" encoding="utf-8"?>
<!-- About: one document row (icon tile, title, chevron). AboutActivity sets the icon and title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/rowIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/about_icon_tile"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/about_accent" />

    <TextView
        android:id="@+id/rowTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/about_text_primary"
        android:textSize="15sp" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_about_chevron"
        app:tint="@color/about_chevron" />
</LinearLayout>
